id: b3f8a1c2-74e9-4d5f-9e1a-2c7f0b843a6d
name: Anomaly-Ranked Injection Probe
function: SCAN_CHECK_ACTIVE_PER_INSERTION_POINT
location: SCANNER
burpglobal:
  bambda-fuzzing: false                    # master on/off; set true to enable (bool)
  anomaly-probe-wordlist: ""               # path to newline-delimited payload file; # lines ignored; falls back to built-in (string)
  anomaly-probe-rank-threshold: 5          # Gate 1: minimum anomaly rank to raise a finding (int)
  anomaly-probe-margin: 2.0                # Gate 2: top rank must be >= this multiple of the corpus median (double)
  anomaly-probe-max-payloads: 25           # payload cap per insertion point (int)
  anomaly-probe-url-encode: false          # false = URL-decode payloads before insertion (prevents double-encoding %-encoded wordlists); true = pass raw (bool)
source: |
  /**
   * Sends a payload corpus per insertion point, ranks responses with ANOMALY,
   * and raises MEDIUM/TENTATIVE when the top payload rank clears both gates:
   *   Gate 1: topRank >= RANK_THRESHOLD
   *   Gate 2: topRank >= MIN_MARGIN_OVER_MEDIAN * median
   **/

  if (!"true".equalsIgnoreCase(System.getProperty("bg.bambda-fuzzing"))) {
      api().logging().logToOutput("[AnomalyProbe] disabled — set bg.bambda-fuzzing=true to enable");
      return AuditResult.auditResult();
  }
  final int     RANK_THRESHOLD                   = Integer.parseInt(
      java.util.Objects.requireNonNullElse(System.getProperty("bg.anomaly-probe-rank-threshold"), "5"));
  final double  MIN_MARGIN_OVER_MEDIAN           = Double.parseDouble(
      java.util.Objects.requireNonNullElse(System.getProperty("bg.anomaly-probe-margin"), "2.0"));
  final int     MAX_PAYLOADS_PER_INSERTION_POINT = Integer.parseInt(
      java.util.Objects.requireNonNullElse(System.getProperty("bg.anomaly-probe-max-payloads"), "25"));
  final boolean URL_ENCODE_PAYLOADS              = Boolean.parseBoolean(
      java.util.Objects.requireNonNullElse(System.getProperty("bg.anomaly-probe-url-encode"), "false"));

  final String ISSUE_NAME = "Anomalous response to injection probes";
  final String ISSUE_BACKGROUND =
      "<p>This check sends a corpus of injection probes to a single insertion point and ranks " +
      "every response using Burp&rsquo;s anomaly-detection algorithm " +
      "(<code>RankingUtils.rank(..., RankingAlgorithm.ANOMALY)</code>). A finding is raised " +
      "only when the top-ranked response stands out from the corpus median by a configurable " +
      "margin, reducing noise from uniformly-unusual behaviour (WAFs, CDNs, error-heavy APIs)." +
      "</p><p>MEDIUM/TENTATIVE means one probe triggered a structurally distinct response. " +
      "Manual review is required. Common true-positive causes: SQL errors, command output, " +
      "template evaluation, path traversal, parser exceptions.</p>";

  // Built-in payload list: %-encoded special characters for double-decode and filter-bypass testing.
  final var FALLBACK_PAYLOADS = java.util.List.of(
      "%00", "%09", "%0a", "%0d", "%20", "%22", "%23", "%25", "%26", "%27",
      "%2b", "%2f", "%3b", "%3c", "%3d", "%3e", "%3f", "%40", "%5c", "%60",
      "%7c", "%7e", "%7f"
  );

  var PAYLOADS = FALLBACK_PAYLOADS;
  var _wordlistPath = System.getProperty("bg.anomaly-probe-wordlist");
  if (_wordlistPath != null) {
      try {
          var _loaded = java.nio.file.Files.readAllLines(java.nio.file.Paths.get(_wordlistPath))
              .stream().map(String::trim)
              .filter(l -> !l.isEmpty() && !l.startsWith("#"))
              .toList();
          PAYLOADS = _loaded;
          api().logging().logToOutput("[AnomalyProbe] loaded " + PAYLOADS.size() + " payloads from: " + _wordlistPath);
      } catch (Exception e) {
          api().logging().logToOutput("[AnomalyProbe] wordlist load failed (" + e.getMessage() + "), using fallback");
      }
  }

  if (insertionPoint == null) return AuditResult.auditResult();
  if (!requestResponse.hasResponse()) {
      api().logging().logToOutput("[AnomalyProbe] skipping " + insertionPoint.name() + " — base requestResponse has no response");
      return AuditResult.auditResult();
  }

  final String ipName = insertionPoint.name();
  final String ipType = insertionPoint.type().toString();

  // Corpus: baseline at index 0 (reference for the ranker), payloads at 1+.
  // Labels parallel corpus by index. The baseline is excluded when selecting
  // the top candidate — a baseline-wins result means no payload stood out.
  var corpus = new java.util.ArrayList<HttpRequestResponse>();
  var labels = new java.util.ArrayList<String>();
  corpus.add(requestResponse);
  labels.add("<baseline>");

  int sent = 0;
  for (var payload : PAYLOADS) {
      if (sent >= MAX_PAYLOADS_PER_INSERTION_POINT) break;
      try {
          // URL-decode by default so %-encoded payloads (e.g. %27) aren't
          // double-encoded by the insertion point to %2527.
          String effectivePayload;
          if (URL_ENCODE_PAYLOADS) {
              effectivePayload = payload;
          } else {
              try {
                  effectivePayload = java.net.URLDecoder.decode(payload, "UTF-8");
              } catch (Exception decodeErr) {
                  effectivePayload = payload;
              }
          }
          var rr = http.sendRequest(insertionPoint.buildHttpRequestWithPayload(ByteArray.byteArray(effectivePayload)));
          if (!rr.hasResponse()) continue;
          corpus.add(rr);
          labels.add(payload); // store original (pre-decode) string as the display label
          sent++;
      } catch (Exception e) {
          api().logging().logToOutput("[AnomalyProbe] send error [" + ipName + "] payload=[" + payload + "]: " + e.getMessage());
      }
  }

  if (corpus.size() < 3) return AuditResult.auditResult();

  java.util.List<burp.api.montoya.utilities.rank.RankedHttpRequestResponse> ranked =
      api().utilities().rankingUtils().rank(corpus, burp.api.montoya.utilities.rank.RankingAlgorithm.ANOMALY);
  if (ranked == null || ranked.isEmpty()) return AuditResult.auditResult();

  ranked.sort((a, b) -> Integer.compare(b.rank(), a.rank())); // descending

  int n = ranked.size();
  int[] sortedRanks = ranked.stream().mapToInt(r -> r.rank()).sorted().toArray();
  double median = (n % 2 == 1)
      ? sortedRanks[n / 2]
      : (sortedRanks[n / 2 - 1] + (double) sortedRanks[n / 2]) / 2.0;

  // Find the highest-ranked payload entry (skip baseline at index 0).
  // requestResponse() may return a wrapper with a different reference, so we
  // match by identity first then fall back to request-byte comparison.
  burp.api.montoya.utilities.rank.RankedHttpRequestResponse top = null;
  String topLabel = null;

  for (int ri = 0; ri < ranked.size() && top == null; ri++) {
      var r = ranked.get(ri);
      HttpRequestResponse candidate = r.requestResponse();
      for (int i = 1; i < corpus.size() && top == null; i++) {
          if (corpus.get(i) == candidate) {
              top = r; topLabel = labels.get(i);
          }
      }
      if (top == null) {
          byte[] candidateBytes = candidate.request().toByteArray().getBytes();
          for (int i = 1; i < corpus.size() && top == null; i++) {
              if (java.util.Arrays.equals(corpus.get(i).request().toByteArray().getBytes(), candidateBytes)) {
                  top = r; topLabel = labels.get(i);
              }
          }
      }
  }

  if (top == null) return AuditResult.auditResult();

  int    topRank = top.rank();
  double margin  = (median > 0.0) ? topRank / median : Double.MAX_VALUE;

  boolean gateAbsolute = topRank >= RANK_THRESHOLD;
  boolean gateMargin   = margin  >= MIN_MARGIN_OVER_MEDIAN;
  boolean raised       = gateAbsolute && gateMargin;

  api().logging().logToOutput(String.format(
      "[AnomalyProbe] %-30s %-22s payloads=%2d  topRank=%d  median=%.1f  margin=%5.2fx  gate1=%s gate2=%s  raised=%s  urlEncode=%s",
      ipName, ipType, sent, topRank, median, margin,
      gateAbsolute ? "PASS" : "fail", gateMargin ? "PASS" : "fail",
      raised ? "YES" : "no", URL_ENCODE_PAYLOADS ? "on" : "off"
  ));

  if (!raised) return AuditResult.auditResult();

  var html = api().utilities().htmlUtils();
  var detail =
      "<p>Anomalous response at insertion point <code>" + html.encode(ipName) + "</code> " +
      "(type: <code>" + html.encode(ipType) + "</code>).</p><ul>" +
      "<li><b>Trigger payload:</b> <code>" + html.encode(topLabel) + "</code></li>" +
      "<li><b>Anomaly rank:</b> " + topRank + " (gate: &ge;&nbsp;" + RANK_THRESHOLD + " &mdash; PASS)</li>" +
      "<li><b>Corpus median rank:</b> " + String.format("%.1f", median) + "</li>" +
      "<li><b>Margin over median:</b> " + String.format("%.2f", margin) + "x (gate: &ge;&nbsp;" + MIN_MARGIN_OVER_MEDIAN + "x &mdash; PASS)</li>" +
      "<li><b>Corpus size:</b> " + corpus.size() + " (incl. baseline)</li>" +
      "</ul><p>Baseline and anomalous requests are attached.</p>";

  return AuditResult.auditResult(
      AuditIssue.auditIssue(
          ISSUE_NAME + " [" + ipName + "]",
          detail,
          "<p>Investigate manually. Anomalous responses indicating server-side evaluation, " +
          "error disclosure, or file leakage should be treated as potential injection vulnerabilities.</p>",
          requestResponse.request().url(),
          AuditIssueSeverity.MEDIUM,
          AuditIssueConfidence.TENTATIVE,
          ISSUE_BACKGROUND,
          "",
          AuditIssueSeverity.MEDIUM,
          requestResponse,
          top.requestResponse()
      )
  );
